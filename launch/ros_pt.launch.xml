<?xml version="1.0" encoding="utf-8"?>

<launch>

  <arg name="vessel_ns"       default="herc"/>
  <arg name="vessel_config"   default="herc"/>

  <node pkg="ros_pt" exec="ros_driver.py" name="ros_pt" namespace="$(var vessel_ns)/control/$(var valve_pack_name)" output="screen">
    <param from="$(find-pkg-share ros_pt)/config/ros_pt.yaml"/>
  </node>

</launch>